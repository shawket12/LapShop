@model List<TbSlider>
<div class="container">
    <h2>Sliders</h2>


<a asp-area="Admin"
   asp-controller="Slider"
   asp-action="AddSlider"
   class="btn btn-primary">
    Add Slider
</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Description</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SliderId</td>

                <td>@item.Title</td>

                <td>@item.Description</td>

                <td>
                    <img src="~/Uploads/Sliders/@item.ImageName"
                         width="150"
                         alt="@item.Title" />
                </td>

                <td>
                    <a asp-area="Admin"
                       asp-controller="Slider"
                       asp-action="UpdateSlider"
                       asp-route-id="@item.SliderId"
                       class="btn btn-warning">
                        Update
                    </a>

                   <form asp-area="Admin"
      asp-controller="Slider"
      asp-action="Delete"
      asp-route-id="@item.SliderId"
      method="post"
      style="display:inline;"
      onsubmit="return confirm('Are you sure you want to delete this slider?');">


<button type="submit"
        class="btn btn-danger">
    Delete
</button>


</form>

                </td>
            </tr>
        }
    </tbody>
</table>


</div>
