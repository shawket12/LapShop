<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@(ViewData["Title"] ?? "LapShop") - Admin</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/Admin/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/Admin/assets/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="~/Admin/assets/vendors/font-awesome/css/font-awesome.min.css" />
    <!-- Layout styles -->
    <link rel="stylesheet" href="~/Admin/assets/css/demo_1/style.css">
    <link rel="shortcut icon" href="~/favicon.ico" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="container-scroller">
        <!-- navbar -->
        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
                <a class="navbar-brand brand-logo fw-bold text-primary" href="/Admin/Home">LapShop</a>
                <a class="navbar-brand brand-logo-mini fw-bold text-primary" href="/Admin/Home">LS</a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-stretch">
                <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <span class="mdi mdi-menu"></span>
                </button>
                <ul class="navbar-nav navbar-nav-right">
                    <li class="nav-item nav-profile dropdown">
                        <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="nav-profile-text">
                                <p class="mb-1 text-black">@(User.Identity?.Name ?? "Admin")</p>
                            </div>
                        </a>
                        <div class="dropdown-menu navbar-dropdown" aria-labelledby="profileDropdown">
                            <a class="dropdown-item" href="/">
                                <i class="mdi mdi-storefront me-2 text-success"></i> View store
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="LoginOut">
                                <i class="mdi mdi-logout me-2 text-primary"></i> Sign out
                            </a>
                        </div>
                    </li>
                    <li class="nav-item d-none d-lg-block full-screen-link">
                        <a class="nav-link">
                            <i class="mdi mdi-fullscreen" id="fullscreen-button"></i>
                        </a>
                    </li>
                </ul>
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                    <span class="mdi mdi-menu"></span>
                </button>
            </div>
        </nav>

        <div class="container-fluid page-body-wrapper">
            <!-- sidebar -->
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <li class="nav-item nav-profile">
                        <a href="#" class="nav-link">
                            <div class="nav-profile-text d-flex flex-column">
                                <span class="font-weight-bold mb-2">@(User.Identity?.Name ?? "Admin")</span>
                                <span class="text-secondary text-small">Administrator</span>
                            </div>
                            <i class="mdi mdi-bookmark-check text-success nav-profile-badge"></i>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/Home">
                            <span class="menu-title">Dashboard</span>
                            <i class="mdi mdi-home menu-icon"></i>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#basicData" aria-expanded="false" aria-controls="basicData">
                            <span class="menu-title">Basic Data</span>
                            <i class="menu-arrow"></i>
                            <i class="mdi mdi-format-list-bulleted menu-icon"></i>
                        </a>
                        <div class="collapse" id="basicData">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"> <a asp-controller="Categories" asp-action="List" class="nav-link">Categories</a></li>
                                <li class="nav-item"> <a asp-controller="Item" asp-action="List" class="nav-link">Items</a></li>
                                <li class="nav-item"> <a asp-controller="Slider" asp-action="List" class="nav-link">Sliders</a></li>
                            </ul>
                        </div>
                    </li>

                    @* Planned sections: not built yet, so they stay disabled until each one is added. *@
                    <li class="nav-item">
                        <a class="nav-link text-muted" href="#" onclick="return false;" title="Coming soon">
                            <span class="menu-title">Orders <small class="badge bg-secondary ms-1">Soon</small></span>
                            <i class="mdi mdi-cart menu-icon"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-muted" href="#" onclick="return false;" title="Coming soon">
                            <span class="menu-title">Customers <small class="badge bg-secondary ms-1">Soon</small></span>
                            <i class="mdi mdi-account-multiple menu-icon"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-muted" href="#" onclick="return false;" title="Coming soon">
                            <span class="menu-title">Store Settings <small class="badge bg-secondary ms-1">Soon</small></span>
                            <i class="mdi mdi-settings menu-icon"></i>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <span class="menu-title">Back to store</span>
                            <i class="mdi mdi-storefront menu-icon"></i>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="main-panel">

                @RenderBody()

                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">Copyright &copy; @DateTime.Now.Year LapShop. All rights reserved.</span>
                    </div>
                </footer>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/Admin/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/Admin/assets/js/off-canvas.js"></script>
    <script src="~/Admin/assets/js/hoverable-collapse.js"></script>
    <script src="~/Admin/assets/js/misc.js"></script>
    @RenderSection("Scripts", false)
</body>
</html>
