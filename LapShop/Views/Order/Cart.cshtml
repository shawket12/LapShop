@model ShoppingCart
@{
    ViewData["Title"] = "Cart";
}

<!-- breadcrumb start -->
<div class="breadcrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-sm-6">
                <div class="page-title">
                    <h2>cart</h2>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb" class="theme-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="breadcrumb-item active">cart</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb End -->

<section class="cart-section section-b-space">
    <div class="container">
        @if (!Model.lstItems.Any())
        {
            <div class="row">
                <div class="col-sm-12 text-center">
                    <h4>Your cart is empty.</h4>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-solid mt-3">continue shopping</a>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-sm-12">
                    <table class="table cart-table table-responsive-xs">
                        <thead>
                            <tr class="table-head">
                                <th scope="col">image</th>
                                <th scope="col">product name</th>
                                <th scope="col">price</th>
                                <th scope="col">quantity</th>
                                <th scope="col">action</th>
                                <th scope="col">total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.lstItems)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Items" asp-action="ItemDetails" asp-route-id="@item.ItemId">
                                            @if (!string.IsNullOrEmpty(item.ImageName))
                                            {
                                                <img src="~/Uploads/Items/@item.ImageName" alt="@item.ItemName">
                                            }
                                        </a>
                                    </td>
                                    <td>
                                        <a asp-controller="Items" asp-action="ItemDetails" asp-route-id="@item.ItemId">@item.ItemName</a>
                                    </td>
                                    <td>
                                        <h2>$@item.Price</h2>
                                    </td>
                                    <td>
                                        <div class="qty-box">
                                            <div class="input-group">
                                                <input type="number" min="1" name="quantity" class="form-control input-number"
                                                       value="@item.qty" data-id="@item.ItemId" data-price="@item.Price" oninput="changeQty(this)">
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a asp-controller="Order" asp-action="RemoveFromCart" asp-route-itemId="@item.ItemId" class="icon" title="Remove"><i class="ti-close"></i></a>
                                    </td>
                                    <td>
                                        <span style="font-size: 23px;">$</span>
                                        <h2 style="display: inline-block;" data-id="@item.ItemId" class="td-color total1">@item.Total</h2>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <table class="table cart-table table-responsive-md">
                        <tfoot>
                            <tr>
                                <td>total price :</td>
                                <td>
                                    <b style="font-size: 23px;">$</b>
                                    <h2 style="display: inline-block;" class="totalprice">@Model.TotalPrice</h2>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="row cart-buttons">
                <div class="col-6"><a asp-controller="Home" asp-action="Index" class="btn btn-solid">continue shopping</a></div>
                <div class="col-6"><a asp-controller="Order" asp-action="OrderSuccess" class="btn btn-solid">check out</a></div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        function changeQty(input) {
            let id = $(input).data("id");
            let qty = parseInt($(input).val());
            if (!qty || qty < 1) { return; }

            $.ajax({
                url: '/Order/ChangeQty',
                type: 'POST',
                data: { id: id, qty: qty },
                success: function (response) {
                    if (response.success) {
                        $('.total1[data-id="' + id + '"]').html(response.itemTotal);
                        $(".totalprice").html(response.totalPrice);
                    }
                }
            });
        }
    </script>
}
