@model VwItem
<div class="product-box col-xl-3 col-lg-4 col-sm-6 col-6">
    <div class="img-wrapper">
        <div class="front">
            <a asp-controller="Items" asp-action="ItemDetails" asp-route-id="@Model.ItemId">
                @if (!string.IsNullOrEmpty(Model.ImageName))
                {
                    <img src="~/Uploads/Items/@Model.ImageName" class="img-fluid blur-up lazyload bg-img" alt="@Model.ItemName">
                }
            </a>
        </div>
        <a class="add-button" asp-controller="Order" asp-action="AddToCart" asp-route-itemId="@Model.ItemId">
            add to cart
        </a>
    </div>
    <div class="product-detail">
        <a asp-controller="Items" asp-action="ItemDetails" asp-route-id="@Model.ItemId">
            <h6>@Model.ItemName</h6>
        </a>
        <h4>$@Model.SalesPrice</h4>
    </div>
</div>
